# ============================================
# InsightAI Production Environment Template
# DO NOT COMMIT ACTUAL VALUES TO GITHUB!
# ============================================

# Database Configuration (Render/Neon Postgres)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Security (JWT configuration)
# Generate a strong key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_generated_secret_key_do_not_leave_placeholder
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mark refresh-token cookie Secure (requires HTTPS)
COOKIE_SECURE=true

# CORS Settings
CORS_ORIGINS=https://frontend-nine-woad-19.vercel.app

# AI Model Keys (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Configuration (Optional)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Twilio WhatsApp Configuration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Environment
ENVIRONMENT=production