ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS=https://frontend-nine-woad-19.vercel.app

# AI Model Keys (Get a free key from https://aistudio.google.com/)
